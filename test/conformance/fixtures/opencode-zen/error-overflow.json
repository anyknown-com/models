{
  "unverified": true,
  "request": {
    "method": "POST",
    "url": "https://opencode.ai/zen/v1/chat/completions",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "model": "gpt-5-nano",
      "messages": [
        {
          "role": "user",
          "content": {
            "$repeat": " a",
            "times": 2100000
          }
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 500,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "message": "request-only"
      }
    }
  }
}

{
  "request": {
    "method": "POST",
    "url": "https://api.openai.com/v1/responses",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "model": "gpt-6-luna",
      "input": [
        {
          "role": "developer",
          "content": "You are a terse assistant."
        },
        {
          "role": "developer",
          "content": "Answer in one short sentence."
        },
        {
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "Name one planet in the solar system."
            }
          ]
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "message": "Incorrect API key provided: anyknown************************0000. You can find your API key at https://platform.openai.com/account/api-keys.",
        "type": "invalid_request_error",
        "param": null,
        "code": "invalid_api_key"
      }
    }
  }
}

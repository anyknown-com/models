{
  "unverified": true,
  "request": {
    "method": "POST",
    "url": "https://api.xiaomimimo.com/v1/chat/completions",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "model": "mimo-v2-flash",
      "messages": [
        {
          "role": "user",
          "content": "What are the weather and the time in Paris right now?"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "get_weather",
            "description": "Get the current weather in a city.",
            "parameters": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": ["city"]
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "get_time",
            "description": "Get the current time in a time zone.",
            "parameters": {
              "type": "object",
              "properties": {
                "timezone": {
                  "type": "string"
                }
              },
              "required": ["timezone"]
            }
          }
        }
      ],
      "tool_choice": "auto",
      "stream": true
    }
  },
  "response": {
    "status": 500,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "message": "request-only"
      }
    }
  }
}

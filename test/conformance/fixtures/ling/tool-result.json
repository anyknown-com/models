          }
        },
        {
          "type": "function",
          "function": {
            "name": "get_time",
            "description": "Get the current time in a time zone.",
            "parameters": {
              "type": "object",
              "properties": {
                "timezone": {
                  "type": "string"
                }
              },
              "required": ["timezone"]
            }
          }
        }
      ],
      "tool_choice": "auto",
      "stream": true
    }
  },
  "response": {
    "status": 500,
    "headers": {

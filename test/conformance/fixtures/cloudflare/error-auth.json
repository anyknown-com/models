{
  "unverified": true,
  "request": {
    "method": "POST",
    "url": "https://gateway.ai.cloudflare.com/v1/chat/completions",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "model": "openai/gpt-5.2",
      "messages": [
        {
          "role": "system",
          "content": "You are a terse assistant."
        },
        {
          "role": "system",
          "content": "Answer in one short sentence."
        },
        {
          "role": "user",
          "content": "Name one planet in the solar system."
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 500,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "message": "request-only"
      }
    }
  }
}

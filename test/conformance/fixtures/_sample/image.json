{
  "request": {
    "method": "POST",
    "url": "https://sample.test/v1/chat/completions",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "model": "sample-model",
      "messages": [
        {
          "role": "system",
          "content": "You are a terse assistant."
        },
        {
          "role": "system",
          "content": "Answer in one short sentence."
        },
        {
          "role": "user",
          "content": "Name one planet in the solar system."
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "chunks": [
      "data: {\"choices\":[{\"delta\":{\"content\":\"Mars.\"},\"finish_reason\":null}]}\n\n",
      "data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":20,\"completion_tokens\":2}}\n\n",
      "data: [DONE]\n\n"
    ]
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@anyknown/models": ["./src/index.ts"],
      "@anyknown/models/is-overflow": ["./src/is-overflow.ts"],
      "@anyknown/models/*": ["./src/*/index.ts"]
    }
  },
  "include": ["src", "test", "examples"]
}
